ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Optional tuning (defaults shown)
# ECHO_MIN_SIMILARITY=0.45          # set from `npm run calibrate` once the control corpus has 30+ articles
# ECHO_REQUIRE_VERIFIED=0           # 1 = match only against verified/translation archive quotes
# ECHO_MODEL_CLASSIFY=claude-sonnet-5-5
# ECHO_MODEL_MATCH=claude-sonnet-5-5
# ECHO_MODEL_TRANSLATE=claude-haiku-5-5
# ECHO_FALLBACKS=1                  # server-side refusal fallback for Sonnet calls (0 = off)
# VOYAGE_MODEL=voyage-3.5-lite      # changing it requires `npm run archive:embed`
