{
  "name": "echo-trace",
  "version": "3.0.0",
  "private": true,
  "description": "ECHO/trace — traces the rhetorical inheritance of contemporary state propaganda",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisosavi/echo-trace.git"
  },
  "scripts": {
    "cycle": "bash scripts/cycle.sh",
    "scrape": "node --env-file-if-exists=.env scripts/scrape-news.mjs",
    "analyze": "node --env-file-if-exists=.env scripts/analyze-new.mjs",
    "archive:check": "node --env-file-if-exists=.env scripts/check-archive.mjs",
    "archive:verify": "node --env-file-if-exists=.env scripts/verify-echo.mjs",
    "archive:embed": "node --env-file-if-exists=.env scripts/precompute-embeddings.mjs",
    "calibrate": "node --env-file-if-exists=.env scripts/calibrate-threshold.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "jsdom": "^29.0.1",
    "puppeteer": "^24.40.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
